github.setup        sonorahq sonora 0.50.3 v
github.tarball_from archive
revision            0

categories          audio aqua
license             GPL-3+
maintainers         nomaintainer
installs_libs       no

description         Native music streaming client
long_description    Sonora is a native, familiar music streaming client \
                    written in Rust with the GPUI toolkit.
homepage            https://sonorahq.org

platforms           {darwin >= 20}
# Upstream builds one binary per architecture; keep it simple here.
universal_variant   no

checksums           ${distname}${extract.suffix} \
                    rmd160  1e85cd3ca62cca837fb8cd00498b3dcc652e8414 \
                    sha256  8e1a1af03675cacbea6e42538b87564f2493120fc56377ed2afbfde710092571 \
                    size    4886726

# SQLite is compiled in: upstream enables rusqlite's "bundled" feature, so
# libsqlite3-sys never looks for a system library.

# crates.io crates below are vendored with checksums. The git dependencies
# (gpui, librespot, wgpu and others) are pinned to exact revisions in
# Cargo.lock, but cargo.crates_github cannot vendor git revisions inside
# workspace repos, so cargo fetches them during the build (like the official
# halloy port). --locked makes cargo refuse anything that differs from
# Cargo.lock.
cargo.offline_cmd   --locked
build.args-append   --package sonora

# GPUI compiles its Metal shaders at build time with Xcode's Metal Toolchain,
# a separate download that MacPorts cannot install. By default build with
# runtime shaders instead: the shader source is embedded and compiled by the
# system Metal framework at launch.
variant metal description {Precompile Metal shaders at build time (needs Xcode's Metal Toolchain)} {
    # MacPorts builds against the Command Line Tools unless a port asks for
    # Xcode, and the Command Line Tools have no metal compiler.
    use_xcode       yes
}

if {![variant_isset metal]} {
    build.args-append   --features runtime-shaders
} else {
    pre-build {
        if {[catch {exec xcrun -sdk macosx metal --version} result]} {
            ui_error "xcrun metal failed: ${result}"
            ui_error "${name} +metal needs Xcode's Metal Toolchain. Install it with:"
            ui_error "    xcodebuild -downloadComponent MetalToolchain"
            ui_error "or build without +metal."
            return -code error "Metal Toolchain not found"
        }
    }
}

# Assemble the app bundle the same way upstream's release workflow does.
destroot {
    set app ${destroot}${applications_dir}/Sonora.app
    xinstall -d ${app}/Contents/MacOS ${app}/Contents/Resources/icons
    xinstall -m 0755 ${worksrcpath}/target/[cargo.rust_platform]/release/sonora \
        ${app}/Contents/MacOS/
    xinstall -m 0644 ${worksrcpath}/assets/macos/sonora.icns \
        ${worksrcpath}/assets/macos/Assets.car ${app}/Contents/Resources/
    xinstall -m 0644 ${worksrcpath}/assets/macos/Info.plist ${app}/Contents/
    reinplace "s|@VERSION@|${version}|g" ${app}/Contents/Info.plist

    xinstall -m 0644 ${worksrcpath}/COPYING ${app}/Contents/Resources/LICENSE
    xinstall -m 0644 ${worksrcpath}/THIRD-PARTY.md ${app}/Contents/Resources/
    xinstall -m 0644 ${worksrcpath}/assets/fonts/LICENSE.txt ${app}/Contents/Resources/LICENSE.Inter
    xinstall -m 0644 ${worksrcpath}/assets/icons/LICENSE ${app}/Contents/Resources/icons/
    foreach licence [glob ${worksrcpath}/assets/icons/*/LICENSE] {
        set pack [file tail [file dirname ${licence}]]
        xinstall -m 0644 ${licence} ${app}/Contents/Resources/icons/LICENSE.${pack}
    }

    # Ad-hoc sign the bundle as upstream does, so the signature covers Info.plist.
    system "codesign --force --sign - [shellescape ${app}]"

    xinstall -d ${destroot}${prefix}/bin
    ln -s ${applications_dir}/Sonora.app/Contents/MacOS/sonora ${destroot}${prefix}/bin/sonora
}

