PortSystem          1.0
PortGroup           kf6 1.0

kf6.setup           solid
revision            0
license             LGPL-2.1+
description         KDE hardware integration and detection
long_description    {*}${description}. Part of KDE Frameworks 6.

checksums           rmd160  ac736ecd1a318e0780be58ac424bed61f7411bef \
                    sha256  82950a3d19a8b3ccac11bbcc297e132b975921e25b386f462abe5727a78f1e35 \
                    size    318548

# Xcode's bison is too old (2.3); solid needs >= 3.0
depends_build-append \
                    port:bison \
                    port:flex

configure.args-append \
                    -DBISON_EXECUTABLE=${prefix}/bin/bison \
                    -DFLEX_EXECUTABLE=${prefix}/bin/flex \
                    -DCMAKE_DISABLE_FIND_PACKAGE_IMobileDevice:BOOL=ON \
                    -DCMAKE_DISABLE_FIND_PACKAGE_PList:BOOL=ON

# Qt-style (.qm) translations need lrelease/lconvert
qt6.depends_build-append qttools
