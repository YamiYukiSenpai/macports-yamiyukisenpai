# Kate loads icons from the compiled-in library (KF6BreezeIcons); the loose
# theme files are not used on macOS. 24px generation needs Python + lxml.
configure.args-append \
                    -DWITH_ICONS_LIBRARY:BOOL=ON \
                    -DSKIP_INSTALL_ICONS:BOOL=ON \
                    -DWITH_ICON_GENERATION:BOOL=OFF \
                    -DCMAKE_DISABLE_FIND_PACKAGE_Python:BOOL=ON
