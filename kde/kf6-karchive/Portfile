PortSystem          1.0
PortGroup           kf6 1.0

kf6.setup           karchive
revision            0
license             LGPL-2.1+
description         Qt 6 addon providing access to numerous types of archives
long_description    {*}${description}. Part of KDE Frameworks 6.

checksums           rmd160  5a4631154161159bc3819606d5447e163c246164 \
                    sha256  95acaf5a459593184104e1c157cef415ec59a33e71674186169e0df33cdacaac \
                    size    831908

depends_build-append port:pkgconfig

# OpenSSL only serves AES-encrypted 7z archives
configure.args-append \
                    -DWITH_OPENSSL:BOOL=OFF \
                    -DCMAKE_DISABLE_FIND_PACKAGE_OpenSSL:BOOL=ON

depends_lib-append  port:zlib \
                    port:bzip2 \
                    port:xz \
                    port:zstd

# Qt-style (.qm) translations need lrelease/lconvert
qt6.depends_build-append qttools
